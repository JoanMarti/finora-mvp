<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the adaptive icon on the warm canvas. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/finora_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/finora_blue</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/finora_canvas</item>
    </style>
</resources>
